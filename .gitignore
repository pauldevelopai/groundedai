# Environment (contain API keys and secrets)
.env
.env.local
.env.production
.env*.local

# Dependencies
node_modules/

# Next.js
.next/
out/
next-env.d.ts

# TypeScript
tsconfig.tsbuildinfo
*.tsbuildinfo

# Build
dist/
build/

# Logs
logs/
*.log

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Uploads (S3 mirror — never commit binary content)
uploads/*
!uploads/.gitkeep

# Coverage / test
coverage/

# Tmp
tmp/

# Producer-generated binary assets (audio/video/images). The producer_assets
# table holds metadata; the actual files are local-only in dev and behind
# object storage in production.
storage/producer/*
!storage/producer/.gitkeep

# Local Claude Code settings — workstation-specific.
.claude/

# Distributor credential-encryption key. In production set ANCHOR_DISTRIBUTION_KEY
# explicitly; this file is the dev fallback. NEVER commit it.
.anchor-distribution-key
