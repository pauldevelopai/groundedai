# ──────────────────────── Grounded — env template ────────────────────────
# Copy to .env (gitignored) and fill in. NEVER commit real values.
# Variables are grouped by feature; some are only required at later build steps.
#
# This file matches what the runtime actually reads. The platform was renamed
# Anchor → Grounded in May 2026 (Phase 2 on 2026-05-15): env vars now start
# with GROUNDED_*. The runtime ignores any ANCHOR_* names. Some lower-level
# identifiers (agent slugs, the anchor_token cookie, the admin@anchor.local
# dev login) were intentionally frozen — see README "Locked rules" #4.

# ─── App basics ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3002                         # Surepath uses 3000, Holly server 3001 — Grounded reserves 3002
SERVER_HOST=localhost

# ─── Database (local Postgres for dev) ─────────────────────────────────
DATABASE_URL=postgresql://user@localhost:5432/grounded

# ─── Auth (roll-our-own; pattern lifted from Holly) ────────────────────
JWT_SECRET=change-this-to-a-random-string-min-32-chars
SESSION_SECRET=change-this-to-another-random-string

# ─── Anthropic (Claude) ────────────────────────────────────────────────
# Required for every Claude call. The model is hardcoded to Haiku 4.5 in
# lib/claude.js — there is no env override (locked rule #1).
ANTHROPIC_API_KEY=sk-ant-...

# ─── Embeddings (Archivist) ────────────────────────────────────────────
# Embeddings run locally via @huggingface/transformers (BAAI/bge-m3, 1024-dim).
# No API key required. First call downloads ~1.3GB to ~/.cache/huggingface.

# ─── Airtable (newsroom directory + Activity Log) ──────────────────────
# Develop AI base. Read-on-demand for Newsrooms; write Activity Log rows.
AIRTABLE_PAT=pat_...
AIRTABLE_BASE_ID=app4FVlF4AAy8Q8s2
AIRTABLE_NEWSROOMS_TABLE_ID=tblUCJtQvYFcSIdxP
AIRTABLE_ACTIVITY_LOG_TABLE_ID=tblbjZL7ckos17au5
AIRTABLE_ACTIVITY_LOG_STREAM=Grounded

# ─── Google Drive (governance corpus + per-newsroom upload mirror) ─────
# Service account preferred for server-side. Required at the governance
# slice and at Archivist uploads-mirror time. Leave blank until then.
GOOGLE_DRIVE_AUTH_METHOD=service_account
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
GOOGLE_DRIVE_GOVERNANCE_FOLDER_ID=        # methodology + jurisdiction packs root
GOOGLE_DRIVE_UPLOADS_PARENT_FOLDER_ID=    # parent folder; per-newsroom subfolders live under this

# ─── AWS S3 (primary upload storage; Drive is mirror) ──────────────────
# Required for Archivist + research dossier uploads in production. Pilot
# uses local disk under storage/ — these can stay blank in dev.
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_UPLOADS_BUCKET=grounded-uploads

# ─── Twilio / WhatsApp (post-pilot; audience channel only) ─────────────
# Locked rule #5: WhatsApp is the Digital News Gatherer's audience channel
# (broadcasts out, tips in, corrections). NOT a journalist interface.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+27XXXXXXXXX

# ─── Ollama fallback (kicks in when Anthropic is unreachable) ──────────
# Locked-Haiku rule still applies — this fallback is availability-only,
# not cost-shopping. Wrapper auto-triggers on Anthropic errors.
# Set GROUNDED_OLLAMA_FALLBACK_DISABLED=1 to disable.
GROUNDED_OLLAMA_FALLBACK_URL=http://localhost:11434
GROUNDED_OLLAMA_FALLBACK_MODEL=gemma3:12b
# GROUNDED_OLLAMA_FALLBACK_DISABLED=1

# ─── Distribution credentials encryption (32-byte AES-256 key, base64) ─
# Used by lib/distribution/crypto.js. In dev, leave blank — a stable
# .grounded-distribution-key file is generated automatically (gitignored).
# In production, set explicitly and back it up; losing the key bricks
# every encrypted social credential in the database.
GROUNDED_DISTRIBUTION_KEY=

# ─── Copywriter / newsroom-profile prompt extensions ───────────────────
# Both default on; flip Style-Fingerprint off after eyeballing real
# outputs per newsroom if it's not helping.
GROUNDED_TOPIC_HINT=on                       # Copywriter sees a "Topic match: …" line
GROUNDED_STYLE_FINGERPRINT_IN_PROMPT=on      # formatForPrompt appends a banded house-style block

# ─── V2 Step 5 — Sensitivity routing escape hatch ──────────────────────
# When 'off', every input is treated as 'public' and the classifier's
# output is ignored. Useful for debugging.
# GROUNDED_SENSITIVITY_ROUTING=off

# ─── V2 Step 6 — Federated execution escape hatch ──────────────────────
# When 'off', treats every newsroom as appliance-less (sensitive jobs
# refuse rather than dispatch to a registered appliance).
# GROUNDED_FEDERATED_EXECUTION=off

# ─── Smoke-test bypass (CI only) ───────────────────────────────────────
# Set to '1' in CI to skip the smoke-test gate on the dev server start.
# GROUNDED_SMOKE_OK=1

# ─── Security Audit — jurisdiction pack override (tests only) ──────────
# Point loadPacks() at a different YAML file. Useful for unit-testing.
# GROUNDED_JURISDICTION_PACK_PATH=/abs/path/to/test-packs.yaml
