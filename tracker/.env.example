# Absorbed Tracker (AI-Legal) — integrated config.
# Point at GROUNDED's shared Postgres (same DB the ai_* tables were imported into).
DATABASE_URL=postgresql://localhost:5433/anchor
# Port the in-repo Tracker service listens on; grounded's next.config.js proxies
# /tracker/* here (override the target with TRACKER_URL in grounded's env).
SERVER_PORT=3055
# Only needed once the admin CRUD + auth-bridge stage lands:
# JWT_SECRET=change-me
