# Grounded newsroom appliance — env template.
# Copy to ../appliances/.env and fill in.

# Required — from the central app's /team page at registration.
APPLIANCE_SECRET=

# Required to enable the heartbeat. Find APPLIANCE_ID in the central
# app's appliance list once registered.
APPLIANCE_ID=
CENTRAL_URL=https://your-grounded-deployment.example

# Optional.
APPLIANCE_PORT=8443
APPLIANCE_HOST=0.0.0.0
PING_INTERVAL_MS=300000
APPLIANCE_VERSION=grounded-appliance/0.1.0
